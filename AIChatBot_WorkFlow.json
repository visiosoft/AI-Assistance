    {
      "parameters": {
        "functionCode": "// Process user profile - extract info and determine if new/existing user\nconst items = $input.all();\nconst currentData = items[0].json;\n\n// Debug: Check what data we're receiving\nconsole.log('🔍 Input data from previous nodes:', JSON.stringify({\n  incomingPhone: currentData.incomingPhone,\n  messageBody: currentData.messageBody,\n  hasResponseData: !!currentData.responseData,\n  responseData: currentData.responseData\n}, null, 2));\n\n// Get existing user data - handle both cases (found and not found)\nlet existingUsers = [];\nlet userExists = false;\nlet existingUser = null;\n\nif (currentData.responseData && Array.isArray(currentData.responseData)) {\n  existingUsers = currentData.responseData;\n  userExists = existingUsers.length > 0;\n  existingUser = userExists ? existingUsers[0] : null;\n} else {\n  // If no responseData, check if we have direct data from Prepare Query\n  existingUsers = currentData.data || currentData.items || [];\n  userExists = existingUsers.length > 0;\n  existingUser = userExists ? existingUsers[0] : null;\n}\n\nconsole.log('👤 User existence check:', {\n  phone: currentData.incomingPhone,\n  userExists: userExists,\n  existingUserCount: existingUsers.length,\n  existingUser: existingUser\n});\n\n// Extract profile information from current message\nconst extractedInfo = extractProfileInfo(currentData.messageBody, currentData.incomingPhone);\n\n// Prepare final data - start with data from Prepare Query\nlet finalData = {\n  incomingPhone: currentData.incomingPhone,\n  messageBody: currentData.messageBody,\n  twilioFrom: currentData.twilioFrom,\n  ...extractedInfo,\n  userExists: userExists,\n  isNewUser: !userExists\n};\n\n// If user exists, merge with existing data from database\nif (userExists && existingUser) {\n  finalData = {\n    ...existingUser,\n    ...finalData,\n    // Always update these fields with current message\n    lastMessage: currentData.messageBody,\n    lastMessageAt: new Date().toISOString(),\n    profileUpdatedAt: new Date().toISOString(),\n    messageCount: (existingUser.messageCount || 0) + 1\n  };\n  \n  console.log('🔄 Updated existing user profile');\n} else {\n  // New user - set initial values\n  finalData.createdAt = new Date().toISOString();\n  finalData.lastMessageAt = new Date().toISOString();\n  finalData.profileUpdatedAt = new Date().toISOString();\n  finalData.messageCount = 1;\n  console.log('🆕 Creating new user profile');\n}\n\nconsole.log('✅ Final data to save:', JSON.stringify({\n  phone: finalData.incomingPhone,\n  name: finalData.name,\n  interests: finalData.interests,\n  messageCount: finalData.messageCount,\n  isNewUser: finalData.isNewUser\n}, null, 2));\n\nreturn [{ json: finalData }];\n\n// Profile extraction function - FIXED VERSION\nfunction extractProfileInfo(messageBody, incomingPhone) {\n  const extractedInfo = {\n    incomingPhone: incomingPhone,\n    lastMessage: messageBody,\n    lastMessageAt: new Date().toISOString(),\n    profileUpdatedAt: new Date().toISOString()\n  };\n\n  // Interest categories\n  const interestCategories = {\n    sports: ['sports', 'football', 'soccer', 'basketball', 'cricket', 'tennis', 'swimming', 'gym', 'workout', 'fitness'],\n    music: ['music', 'singing', 'guitar', 'piano', 'drums', 'concerts', 'spotify', 'songs'],\n    arts: ['art', 'painting', 'drawing', 'photography', 'design', 'creative', 'crafts'],\n    entertainment: ['movies', 'netflix', 'cinema', 'tv shows', 'gaming', 'video games', 'anime'],\n    outdoor: ['travel', 'hiking', 'camping', 'adventure', 'nature', 'beach', 'mountains']\n  };\n\n  // Extract interests\n  const foundInterests = [];\n  for (const [category, keywords] of Object.entries(interestCategories)) {\n    for (const keyword of keywords) {\n      const regex = new RegExp(`\\\\b${keyword}\\\\b`, 'i');\n      if (regex.test(messageBody)) {\n        foundInterests.push(category);\n        break;\n      }\n    }\n  }\n  if (foundInterests.length > 0) {\n    extractedInfo.interests = [...new Set(foundInterests)].join(', ');\n  }\n\n  // Age extraction\n  const ageMatch = messageBody.match(/(\\b\\d{1,2}\\b)\\s*(years?|yrs?|yo|age)/i);\n  if (ageMatch) {\n    const age = parseInt(ageMatch[1]);\n    if (age >= 18 && age <= 80) {\n      extractedInfo.age = age;\n    }\n  }\n\n  // FIXED: Better gender extraction with word boundaries and context\n  const lowerMessage = messageBody.toLowerCase();\n  \n  // Check for gender patterns with better context\n  if (/\\b(male|man|boy|he|him|his)\\b/i.test(messageBody) && \n      !/\\b(female|woman|girl|she|her)\\b/i.test(messageBody)) {\n    extractedInfo.gender = 'male';\n  } else if (/\\b(female|woman|girl|she|her)\\b/i.test(messageBody) && \n             !/\\b(male|man|boy|he|him|his)\\b/i.test(messageBody)) {\n    extractedInfo.gender = 'female';\n  }\n  \n  // Alternative: if user explicitly says \"I am female/male\"\n  const explicitGenderMatch = messageBody.match(/i am\\s+(male|female|man|woman|boy|girl)/i);\n  if (explicitGenderMatch) {\n    const genderWord = explicitGenderMatch[1].toLowerCase();\n    if (genderWord === 'male' || genderWord === 'man' || genderWord === 'boy') {\n      extractedInfo.gender = 'male';\n    } else if (genderWord === 'female' || genderWord === 'woman' || genderWord === 'girl') {\n      extractedInfo.gender = 'female';\n    }\n  }\n\n  // Location extraction\n  const locationMatch = messageBody.match(/(?:in|from|live in)\\s+([a-zA-Z\\s]{2,})/i);\n  if (locationMatch && locationMatch[1]) {\n    extractedInfo.location = locationMatch[1].trim();\n  }\n\n  // FIXED: Better name extraction that excludes gender words\n  const nameMatch = messageBody.match(/(?:my name is|i am|i'm|call me)\\s+([a-zA-Z]{2,})(?:\\s|$|\\.|,)/i);\n  if (nameMatch && nameMatch[1]) {\n    const potentialName = nameMatch[1].trim();\n    // Exclude common gender words from being captured as names\n    const genderWords = ['male', 'female', 'man', 'woman', 'boy', 'girl', 'he', 'she', 'his', 'her'];\n    if (!genderWords.includes(potentialName.toLowerCase())) {\n      extractedInfo.name = potentialName.charAt(0).toUpperCase() + potentialName.slice(1).toLowerCase();\n    }\n  }\n\n  // Alternative name pattern if the first one didn't catch it\n  if (!extractedInfo.name) {\n    const altNameMatch = messageBody.match(/(?:name[']?s\\s+)([a-zA-Z]{2,})/i);\n    if (altNameMatch && altNameMatch[1]) {\n      extractedInfo.name = altNameMatch[1].charAt(0).toUpperCase() + altNameMatch[1].slice(1).toLowerCase();\n    }\n  }\n\n  // Debug extraction results\n  console.log('🔍 Profile extraction results:', {\n    message: messageBody,\n    nameFound: extractedInfo.name,\n    genderFound: extractedInfo.gender,\n    ageFound: extractedInfo.age,\n    locationFound: extractedInfo.location,\n    interestsFound: extractedInfo.interests\n  });\n\n  return extractedInfo;\n}"
      },
