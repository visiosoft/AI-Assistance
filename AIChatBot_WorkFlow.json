        "prompt": "=You are a structured data extractor. \nRead the message below and return exactly ONE valid JSON object. \nDo not repeat, rephrase, or generate multiple JSON objects. \n\n\nMESSAGE: \"{{ $json.lastMessage }}\"\n\nExtract all personal, professional, and interest-related information mentioned in the message. Include, but do not limit to:\n- name, nickname, or username\n- age, birthdate, or date of birth\n- phone numbers, email addresses, or other contact info\n- city, country, location, or address\n- profession, job title, company, or work experience\n- years of experience, skills, or expertise\n- hobbies, interests, favorite activities, or fields of interest\n- personal traits, qualities, or characteristics\n- social media handles or online profiles\n\nRules:\n1. Include all keys that are present or implied in the message.\n2. Convert experience, profession, and traits into key-value pairs (e.g., \"profession\":\"Transport business owner\", \"experience\":\"10 years in logistics\").\n3. Return exactly one JSON object in a single line, with no duplicates.\n4. If no personal or interest-related information is present, return {}.\n\nExample output:\n{\"name\":\"Zul\",\"age\":40,\"city\":\"Dubai\",\"country\":\"United Arab Emirates\",\"profession\":\"Transport business owner\",\"experience\":\"10 years in logistics and passenger transport\",\"traits\":\"hardworking, disciplined, goal-oriented\",\"interest\":\"traveling, exploring new technologies, networking\"}",
        "options": {},
        "requestOptions": {}
      },
      "id": "a5ca6e9b-2190-471f-9048-c9d609dd1809",
      "name": "AI Data Extractor",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        -112,
        1152
      ],
      "credentials": {
        "openAiApi": {
          "id": "0swYYFLx0kh79pxV",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "const items = $input.all();\nconst prepareQuery = $('Prepare Query').first().json;\nconst phoneno = prepareQuery.incomingPhone;\n\nconst output = [];\n\nfor (const item of items) {\n  try {\n    const text = item.json.text;\n    if (!text) {\n      output.push({ error: 'Missing text field', phone: phoneno });\n      continue;\n    }\n\n    // Clean and normalize text\n    let cleanText = text\n      .replace(/```json|```/g, '')\n      .replace(/\\\\n/g, '')\n      .trim();\n\n    // Remove wrapping quotes if present\n    if (cleanText.startsWith('\"') && cleanText.endsWith('\"')) {\n      cleanText = cleanText.slice(1, -1);\n    }\n\n    let parsed = {};\n\n    // Try JSON.parse first\n    try {\n      parsed = JSON.parse(cleanText);\n    } catch (err) {\n      // If not valid JSON, extract key-value pairs via regex\n      const regex = /\"([\\w\\s]+)\"\\s*:\\s*(?:\"([^\"]+)\"|(\\d+))/g;\n      let match;\n      while ((match = regex.exec(cleanText)) !== null) {\n        const key = match[1].trim();\n        const value = match[2] ?? (match[3] ? Number(match[3]) : null);\n        if (value !== null && value !== undefined) {\n          parsed[key] = value;\n        }\n      }\n    }\n\n    // Include phone number in the output\n    parsed.incomingPhone = phoneno;\n\n    // Push the parsed data\n    output.push(Object.keys(parsed).length ? parsed : { info: 'No valid data extracted', phone: phoneno });\n\n  } catch (err) {\n    output.push({ error: err.message, phone: phoneno });\n  }\n}\n\nreturn output.length ? output : [{ info: 'No valid JSON found', phone: phoneno }];\n"
      },
